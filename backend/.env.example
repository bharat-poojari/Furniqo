# Backend environment variables example
PORT=5000
NODE_ENV=production
DB_PATH=./furniqo.db
JWT_SECRET=YOUR_VERY_STRONG_SECRET_HERE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=YOUR_VERY_STRONG_REFRESH_SECRET_HERE_32_CHARS
ADMIN_EMAIL=admin@furniqo.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE
# IMPORTANT: Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://the-furniqo.vercel.app,http://localhost:3000,http://localhost:5173
ALLOW_ADMIN_REGISTER=false
SINGLE_SESSION=true